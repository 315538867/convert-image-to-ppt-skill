{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:img2ppt:schema:v2:source-package",
  "title": "Image-to-PPT V2 Source Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractKind", "sourceId", "rawBlob", "canonicalPixels", "mediaType", "pages", "color", "alpha", "derivedBlobs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "contractKind": { "const": "source-package" },
    "sourceId": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/identifier" },
    "rawBlob": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/blobRef" },
    "canonicalPixels": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/blobRef" },
    "mediaType": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/mediaType" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageId", "canvas", "orientation"],
        "properties": {
          "pageId": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/identifier" },
          "canvas": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/canvas" },
          "orientation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["original", "applied"],
            "properties": {
              "original": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
              "applied": { "type": "boolean" }
            }
          }
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workingSpace"],
      "properties": {
        "originalProfileDigest": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/digest" },
        "workingSpace": { "enum": ["srgb", "display-p3"] }
      }
    },
    "alpha": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "nonOpaquePixelCount"],
      "properties": {
        "present": { "type": "boolean" },
        "nonOpaquePixelCount": { "type": "integer", "minimum": 0 }
      }
    },
    "derivedBlobs": { "type": "array", "items": { "$ref": "urn:img2ppt:schema:v2:shared#/$defs/blobRef" } }
  }
}
